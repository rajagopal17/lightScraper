{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ADB scraper (headless)",
            "type": "debugpy",
            "request": "launch",
            "module": "adb_scraper.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "ADB scraper (headed, no AI)",
            "type": "debugpy",
            "request": "launch",
            "module": "adb_scraper.main",
            "args": ["--headed", "--no-ai"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        }
    ]
}
