# Copy to .env and fill in. Never commit the real .env.

# Required for AI context enrichment; leave blank to run keyword-only
# (ai_relevance/ai_summary/ai_model columns stay NULL, nothing else changes).
OPENAI_API_KEY=

# --- AI guardrails (safe defaults; override only if you know why) ---
ADB_SCRAPER_ENABLE_AI_CONTEXT=true
ADB_SCRAPER_OPENAI_MODEL=gpt-4o-mini
ADB_SCRAPER_AI_TIMEOUT_SECONDS=20
ADB_SCRAPER_AI_MAX_RETRY_ATTEMPTS=2
ADB_SCRAPER_AI_RETRY_BASE_DELAY_SECONDS=2
ADB_SCRAPER_AI_MAX_OUTPUT_TOKENS=200
ADB_SCRAPER_AI_MAX_INPUT_CHARS=1500
ADB_SCRAPER_AI_MAX_CALLS_PER_RUN=100

# --- Browser/scrape guardrails ---
ADB_SCRAPER_MAX_PAGES=50
ADB_SCRAPER_RETRY_MAX_ATTEMPTS=4
ADB_SCRAPER_RETRY_BASE_DELAY_SECONDS=2
ADB_SCRAPER_ACTION_SETTLE_SECONDS=1.5
ADB_SCRAPER_PAGE_NAV_TIMEOUT_MS=30000
ADB_SCRAPER_PAGE_WAIT_TIMEOUT_MS=15000

# --- Paths (defaults match the Docker image; override for bare-metal runs) ---
# ADB_SCRAPER_DB_PATH=./data/adb_ngo_notices.db
# ADB_SCRAPER_LOG_DIR=./logs
# ADB_SCRAPER_JSON_PATH=./data/notices.json
